rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Шинэ хэрэглэгч үүсэхэд lumioId нь counters/users тоолуурын шинэ утгатай
    // яг таарч байх ёстой (нэг transaction дотор) — ингэснээр ID давхцахгүй,
    // өсөх эрэмбэтэй байх нь баталгаажна.
    function lumioIdMatchesCounter() {
      return request.resource.data.lumioId is int
        && request.resource.data.lumioId ==
          getAfter(/databases/$(database)/documents/counters/users).data.lastId;
    }

    function validUserCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'lumioId',
          'name',
          'displayName',
          'email',
          'photoURL',
          'role',
          'provider',
          'emailVerified',
          'subscription',
          'readerTheme',
          'autoNextChapter',
          'dataSaverMode',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ])
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        // Хэрэглэгч өөрийгөө админ болгож чадахгүй.
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        // Хэрэглэгч өөртөө төлбөртэй эрх оноож чадахгүй.
        && (!('subscription' in request.resource.data) || (
          request.resource.data.subscription.plan == 'free'
          && request.resource.data.subscription.status == 'none'
        ))
        && (!('lumioId' in request.resource.data) || lumioIdMatchesCounter());
    }

    function validUserUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly([
          'name',
          'displayName',
          'photoURL',
          'readerTheme',
          'autoNextChapter',
          'dataSaverMode',
          'updatedAt',
          'lastLoginAt',
          'emailVerified',
          'lumioId'
        ])
        // lumioId-г зөвхөн байхгүй үед нь нэг л удаа (тоолууртай хамт) онооно.
        && (!affected.hasAny(['lumioId']) || (
          !('lumioId' in resource.data) && lumioIdMatchesCounter()
        ))
        // emailVerified нь Firebase Auth token-ийн бодит утгатай таарах ёстой.
        && (!affected.hasAny(['emailVerified'])
          || request.resource.data.emailVerified == request.auth.token.email_verified);
    }

    // Админ хэрэглэгчийн эрх, гишүүнчлэлийг удирдана; харин uid болон
    // lumioId-г өөрчилж давхцал үүсгэхийг хориглоно.
    function validAdminUserUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['uid', 'lumioId']);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if validUserCreate(userId);
      allow update: if (isOwner(userId) && validUserUpdate())
        || (isAdmin() && validAdminUserUpdate());
      allow delete: if isAdmin();
    }

    match /users/{userId}/readingProgress/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /users/{userId}/chapterProgress/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /users/{userId}/library/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /users/{userId}/likes/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /users/{userId}/views/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    // Хэрэглэгчийн өсөх дугаарлалтын тоолуур. Зөвхөн 1-ээр нэмэгдүүлэх
    // боломжтой тул ID алгасах/давхцах боломжгүй.
    match /counters/users {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['lastId', 'updatedAt'])
        && request.resource.data.lastId == 1;
      allow update: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['lastId', 'updatedAt'])
        && request.resource.data.lastId == resource.data.lastId + 1;
    }

    // Нийтлэгдээгүй (ноорог) комикийг зөвхөн админ харна.
    match /comics/{comicId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Нийтлэгдээгүй бүлгийг зөвхөн админ харна; уншихад нэвтэрсэн байх шаардлагатай.
    match /chapters/{chapterId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.isPublished == true);
      allow create, update, delete: if isAdmin();
    }

    match /genres/{genreId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comics/{comicId}/chapters/{chapterId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /readingHistory/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /bookmarks/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /homepageCarousel/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
