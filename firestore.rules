rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validUserCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'displayName',
          'email',
          'uniqueId',
          'photoURL',
          'createdAt',
          'readerTheme',
          'autoNextChapter',
          'dataSaverMode'
        ])
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
    }

    function validUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'displayName',
        'photoURL',
        'readerTheme',
        'autoNextChapter',
        'dataSaverMode'
      ]);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if validUserCreate(userId);
      allow update: if (isOwner(userId) && validUserUpdate()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId}/readingProgress/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /users/{userId}/chapterProgress/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /users/{userId}/library/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /users/{userId}/likes/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /users/{userId}/views/{documentId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /usedIds/{documentId} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['inUse', 'timestamp'])
        && request.resource.data.inUse == true;
    }

    match /comics/{comicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /chapters/{chapterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /genres/{genreId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comics/{comicId}/chapters/{chapterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /readingHistory/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /bookmarks/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /homepageCarousel/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
