rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isImageWithinLimit(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /comics/{storageFolder}/{fileName} {
      allow read: if true;
    }

    match /comics/{storageFolder}/{chapterFolder}/{fileName} {
      allow read: if isSignedIn();
    }

    match /comics/{allPaths=**} {
      allow create, update: if isAdmin() && isImageWithinLimit(15 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isImageWithinLimit(5 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /profiles/{legacyFileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
